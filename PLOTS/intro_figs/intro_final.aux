\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Soft assignments across augmentations.} A frozen TinyImageNet ResNet-18 encoder assigns the real image to the ten shown synthetic prototypes using softmax over $\ell _2$-normalized feature similarities ($\tau =0.025$). Each view applies the same transform to all images. Percentages are normalized over these ten prototypes; both panels use the same 0--35\% radial scale. Four left-panel values are manually adjusted for illustration.}}{1}{}\protected@file@percent }
\newlabel{fig:prototype-assignments}{{1}{1}}
